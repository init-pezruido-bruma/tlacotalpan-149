# Solo hace falta si brochureDelivery en content.ts está en "resend".
# Llave de Resend (https://resend.com). El dominio del remitente debe estar verificado.
RESEND_API_KEY=

# Remitente verificado en Resend. El buzón no tiene que existir; el dominio sí.
BROCHURE_FROM="Tlacotalpan 149 <noreply@birkat.com.mx>"

# Destino. Si se omite, las solicitudes llegan a rpp@birkat.com.mx.
# BROCHURE_TO=rpp@birkat.com.mx
